# ===== 时光照相馆 · 后端环境变量模板 =====
# 用法：复制本文件为 server/.env 并填入真实值（.env 不进仓库）。
# 云托管部署时：把下方变量逐项填进「云托管控制台 → 服务 → 环境变量」，
#               不要把本文件直接传上云（密钥会进镜像层，不安全）。
# 本地联调：复制为 .env 放在 server/ 根目录即可被 dotenv 读取。

# ───────── 服务基础 ─────────
# 云托管会自动注入 PORT（容器内监听端口），此处保持默认即可，无需改。
# 本地不填默认 3000。
PORT=3000
# ⚠️ 部署到云托管必须设为 production：触发启动期配置校验（缺密钥即拒绝启动），
#    并关闭调试日志、开启日志脱敏。本地联调用 development。
NODE_ENV=production

# ───────── 数据库（TencentDB for MySQL / CynosDB）─────────
# 云托管与数据库实例需在「同一云开发环境 / 同一 VPC」内，用内网地址填这里。
DB_HOST=172.17.0.11
DB_PORT=3306
DB_USER=photo_app
# ⚠️ 生产环境 DB_PASSWORD 必填，空密码会在启动校验中强制失败。
# ⚠️ 占位符：部署到云托管时填入真实密码。含 @ 不影响——代码用独立参数连库，非 URL。
DB_PASSWORD=<your_db_password>
DB_NAME=photo-studio-prod-d4do8450eee8709
# 部署前请先执行 database/schema.sql 初始化表结构（users / orders / memberships / images / templates / payment_logs）。

# ───────── Redis（云缓存）─────────
# 生产环境 REDIS_PASSWORD 必填（启动校验强制）。
REDIS_HOST=172.17.0.16
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>

# ───────── JWT ─────────
# ⚠️ 生产环境必填，且必须是高强度随机串；默认值仅本地联调，绝不能上生产。
# 生成方法：`python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=<64位随机十六进制字符串>

# ───────── 微信小程序（真实登录 + JSAPI 支付必填）─────────
WX_APPID=wx70ad245f96b3dfd3
# 微信公众平台「开发管理 → 开发设置 → 开发者 ID」中的 AppSecret。
# ⚠️ 占位符：部署到云托管时填入真实密钥。泄露后任何人可伪装你的小程序调用微信接口。
WX_SECRET=<your_wechat_appsecret>

# ───────── 微信支付（JSAPI 真实支付）─────────
# 微信支付商户号（商户平台「账户中心 → 商户信息」）。
WXPAY_MCHID=your_mchid_here
# APIv3 密钥（商户平台「APIv3 密钥」设置，32 位字符串）。
WXPAY_API_V3_KEY=your_apiv3_key_here
# 商户 API 证书序列号（商户平台「API 证书」查看，是「证书序列号」不是「证书编号」）。
WXPAY_SERIAL_NO=your_cert_serial_no_here
# 商户 API 私钥：二选一
#   方式一（推荐）：直接粘贴私钥全文（-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----）
WXPAY_PRIVATE_KEY=
#   方式二：填私钥 pem 文件绝对路径（与方式一互斥，方式一优先）。
WXPAY_PRIVATE_KEY_PATH=
# 支付结果通知地址：必须公网可达的 HTTPS 域名，且已在商户平台登记。路径固定为 /api/pay/callback
# 例：https://<你的云托管域名>/api/pay/callback
WXPAY_NOTIFY_URL=https://your-domain.com/api/pay/callback
# 启用判定：当 WX_APPID + WXPAY_MCHID + WXPAY_API_V3_KEY + WXPAY_SERIAL_NO + (私钥) 全部存在时，
# server/config 自动将 wxpay.enabled 置为 true，下单与回调走真实微信支付；否则回退开发态。

# ───────── 对象存储（腾讯云 COS，AI 生图 / 上传图落盘处）─────────
# 未配置时 uploadImage 回退本地磁盘（容器重启即丢，仅本地联调用）。生产必配。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=        # 形如 photo-studio-1250000000
COS_REGION=        # 形如 ap-shanghai
COS_CDN_DOMAIN=    # 形如 https://cdn.example.com —— 必须加入小程序「downloadFile 合法域名」

# ───────── 豆包（火山方舟）文生图大模型 ─────────
# 在火山方舟控制台创建 API Key：https://console.volcengine.com/ark
# 前端已改为走后端代理，此 Key 仅存于服务端，不会下发到小程序包。
DOUBAO_API_KEY=your_doubao_api_key_here
# 模型名以你方舟控制台已开通的为准（config 默认 doubao-seedream-4-0-250828）。
DOUBAO_MODEL=doubao-seedream-4-0-250828
# 接口地址（一般无需改）。
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 单张估算费用（美元），仅用于额度展示，实际以火山方舟账单为准。
DOUBAO_EST_COST=0.01
